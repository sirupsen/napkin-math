#!/usr/bin/env bash
# Measure the README SSD rows with fio.
#
#   script/ssd-fio /mnt/nvme/fio.dat      # a file on a mounted file system (ext4 etc.)
#   script/ssd-fio /dev/nvme1n1           # a raw, unused block device (destroys its contents)
#
# A file target measures what applications see, including the file system's fsync cost. A raw
# device skips the file system. NAPKIN_FIO_SIZE (default 32G) sets the test size; NAPKIN_FIO_RUNTIME
# (default 15) the seconds per test.
set -euo pipefail

target="${1:?usage: $0 <file-on-mounted-fs | /dev/raw-device>}"
size="${NAPKIN_FIO_SIZE:-32G}"
runtime="${NAPKIN_FIO_RUNTIME:-15}"

command -v fio >/dev/null || { echo "fio is not installed (apt-get install fio)" >&2; exit 1; }

size_bytes=$(numfmt --from=iec "${size}")
if [[ -b "${target}" ]]; then
  if [[ -n "$(lsblk -no MOUNTPOINT,FSTYPE "${target}" | tr -d ' \n')" ]]; then
    echo "${target} is mounted or has a file system on it; refusing to write to it" >&2
    exit 1
  fi
  if [[ "${NAPKIN_FIO_DESTROY_DEVICE:-}" != "${target}" ]]; then
    echo "writing to ${target} destroys its contents; rerun with NAPKIN_FIO_DESTROY_DEVICE=${target}" >&2
    exit 1
  fi
else
  dir="$(dirname "${target}")"
  [[ -d "${dir}" ]] || { echo "${dir} does not exist" >&2; exit 1; }
  # Check the file system the file actually lands on, with 2x headroom: an earlier run filled a
  # boot disk because the "SSD array" path turned out to be a symlink onto it.
  avail=$(df --output=avail -B1 "${dir}" | tail -1)
  if (( avail < 2 * size_bytes )); then
    echo "only $(numfmt --to=iec "${avail}") free on $(df --output=target "${dir}" | tail -1); need 2x ${size}" >&2
    exit 1
  fi
  echo "file system: $(df --output=source,fstype,target "${dir}" | tail -1)"
  trap 'rm -f "${target}"' EXIT
fi

run() {
  local name="$1"
  shift
  sudo fio --name="${name}" --filename="${target}" --size="${size}" --group_reporting \
    --output-format=json "$@" | python3 -c '
import json, sys
job = json.load(sys.stdin)["jobs"][0]
for kind in ("read", "write"):
    s = job[kind]
    if s["io_bytes"] == 0:
        continue
    lat = s["clat_ns"]
    p50 = lat.get("percentile", {}).get("50.000000", 0) / 1e3
    sync = job.get("sync", {}).get("lat_ns", {}).get("mean")
    extra = "  fsync_mean=%.1fus" % (sync / 1e3) if sync else ""
    print("%-28s %5s  iops=%9.0f  MiB/s=%7.0f  lat_mean=%8.1fus  p50=%8.1fus%s" % (
        sys.argv[1], kind, s["iops"], s["bw_bytes"] / 2**20, lat["mean"] / 1e3, p50, extra))
' "${name}"
}

direct=(--direct=1 --ioengine=io_uring)
timed=(--runtime="${runtime}" --time_based)

# Write the whole range first: reads of never-written blocks can be served without touching flash.
run precondition "${direct[@]}" --rw=write --bs=1M --iodepth=32 >/dev/null
run seq_read_1m_qd32 "${direct[@]}" "${timed[@]}" --rw=read --bs=1M --iodepth=32
run seq_read_8k_buffered --direct=0 --ioengine=psync --invalidate=1 "${timed[@]}" --rw=read --bs=8k
run rand_read_8k_qd1 "${direct[@]}" "${timed[@]}" --rw=randread --bs=8k --iodepth=1
run rand_read_8k_qd32x4 "${direct[@]}" "${timed[@]}" --rw=randread --bs=8k --iodepth=32 --numjobs=4
run seq_write_1m_qd32 "${direct[@]}" "${timed[@]}" --rw=write --bs=1M --iodepth=32
run seq_write_8k_buffered --direct=0 --ioengine=psync --runtime=5 --time_based --rw=write --bs=8k
run seq_write_8k_fdatasync --direct=0 --ioengine=psync "${timed[@]}" --rw=write --bs=8k --fdatasync=1
