#!/usr/bin/env bash
# Measure the README network rows between two hosts.
#
#   script/net-pair --server               # on host A: start iperf3 and netserver
#   script/net-pair <host-A-private-ip>    # on host B: RTT, request/response and bandwidth
#
# Needs iperf3 and netperf on both hosts (apt-get install iperf3 netperf), and the hosts' firewall
# must allow TCP 5201 (iperf3) and 12865 plus ephemeral ports (netperf) between them.
set -euo pipefail

for tool in iperf3 netperf netserver; do
  command -v "${tool}" >/dev/null || { echo "${tool} is not installed (apt-get install iperf3 netperf)" >&2; exit 1; }
done

if [[ "${1:-}" == "--server" ]]; then
  pgrep -x iperf3 >/dev/null || iperf3 -s -D
  pgrep -x netserver >/dev/null || netserver
  echo "iperf3 and netserver running; stop them with: pkill -x iperf3; pkill -x netserver"
  exit 0
fi

server="${1:?usage: $0 --server | <server-ip>}"
seconds="${NAPKIN_NET_SECONDS:-15}"

echo "=== $(hostname) -> ${server}"
echo "--- ICMP ping (often slower than TCP on cloud networks)"
ping -c 100 -i 0.05 -q "${server}" | tail -1

for size in 1 32768; do
  echo "--- netperf TCP_RR ${size} B request/response (latency in us)"
  netperf -H "${server}" -t TCP_RR -l "${seconds}" -- -r "${size},${size}" \
    -o min_latency,mean_latency,p50_latency,p99_latency,transaction_rate | tail -2
done

for flows in 1 8 32; do
  iperf3 -c "${server}" -P "${flows}" -t "${seconds}" -J | python3 -c '
import json, sys
end = json.load(sys.stdin)["end"]
bps = end["sum_received"]["bits_per_second"]
print("--- iperf3 %s flow(s): %.2f Gbit/s = %.2f GiB/s, retransmits %s" % (
    sys.argv[1], bps / 1e9, bps / 8 / 2**30, end["sum_sent"].get("retransmits")))
' "${flows}"
done
