#!/usr/bin/env bash
# Run the Criterion suite:
#
#   ./run                         # same as ./run --bench napkin_math
#   ./run --bench napkin_math -- 'memory_latency|syscall'
#   NAPKIN_TUNE=1 ./run           # quieter Linux host, for comparing two runs
#
# Builds first, then runs `cargo bench` with -C target-cpu=native added to RUSTFLAGS. That is how
# the README numbers were measured: on stock cloud VMs, untuned.
#
# NAPKIN_TUNE=1 turns turbo off, sets the `performance` governor and disables ASLR, using sudo, so
# two runs on the same host vary less. It understates production speed, so don't refresh README
# numbers with it. Each step is skipped when the host doesn't expose it (most cloud VMs), and
# everything is put back on exit. Run as your normal user so cargo is on PATH.
# https://easyperf.net/blog/2019/08/02/Perf-measurement-environment-on-Linux
#
# NAPKIN_PERF=1 wraps the run in `perf stat`.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

if [[ $# -eq 0 ]]; then
  set -- --bench napkin_math
fi
export RUSTFLAGS="${RUSTFLAGS:+${RUSTFLAGS} }-C target-cpu=native"

# Build before touching the host: compiling with turbo off is slow, and a compile error should not
# wait behind sudo. Arguments after `--` go to the benchmark binary, not to the build.
build_args=()
for arg in "$@"; do
  [[ "${arg}" == "--" ]] && break
  build_args+=("${arg}")
done
cargo bench --no-run ${build_args[@]+"${build_args[@]}"}

bench=(cargo bench "$@")
if [[ "${NAPKIN_PERF:-0}" == "1" ]]; then
  if command -v perf >/dev/null; then
    bench=(perf stat -- "${bench[@]}")
  else
    echo "NAPKIN_PERF=1 but perf is not installed; running without it" >&2
  fi
fi

if [[ "${NAPKIN_TUNE:-0}" != "1" ]]; then
  exec "${bench[@]}"
fi
if [[ "$(uname -s)" != "Linux" ]]; then
  echo "NAPKIN_TUNE=1 only works on Linux; running untuned" >&2
  exec "${bench[@]}"
fi

# Ask for the password now, and keep sudo's cached login fresh: a full run outlasts its default
# 15 minutes, and the restore on exit needs sudo too.
sudo -v
while sleep 60; do sudo -n true || exit; done &
keepalive=$!

restore=()

# set_value <file> <value>: write a sysfs/procfs value, remembering the old one for exit.
set_value() {
  local file="$1" value="$2" old
  [[ -e "${file}" ]] || return 0
  old="$(cat "${file}")"
  [[ "${old}" == "${value}" ]] && return 0
  echo "${value}" | sudo tee "${file}" >/dev/null
  restore+=("${file}=${old}")
}

cleanup() {
  local i entry
  for ((i = ${#restore[@]} - 1; i >= 0; i--)); do
    entry="${restore[i]}"
    echo "${entry#*=}" | sudo tee "${entry%%=*}" >/dev/null || echo "could not restore ${entry}" >&2
  done
  kill "${keepalive}" 2>/dev/null || true
}
trap cleanup EXIT

set_value /sys/devices/system/cpu/intel_pstate/no_turbo 1
set_value /sys/devices/system/cpu/cpufreq/boost 0
for governor in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  set_value "${governor}" performance
done
set_value /proc/sys/kernel/randomize_va_space 0

echo "tuned: ${#restore[@]} setting(s) changed, restored on exit" >&2
"${bench[@]}"
